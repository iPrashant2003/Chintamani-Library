# ============================================================
# Chintamani Library — Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# ============================================================

# --- Database ---
DB_USER=chintamani
DB_PASSWORD=chintamani_secret
DB_NAME=chintamani_library
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"

# --- JWT ---
JWT_SECRET=change_me_to_a_very_long_random_string_at_least_64_chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change_me_to_another_very_long_random_string_at_least_64_chars
REFRESH_TOKEN_EXPIRES_IN=7d

# --- App ---
APP_PORT=3000
APP_ENV=development
APP_NAME=Chintamani Library API
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Storage (local filesystem by default) ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
# STORAGE_PROVIDER=cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Firebase (Push Notifications) ---
# Fill in after setting up Firebase project
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- SMS Provider (MSG91 example) ---
# SMS_PROVIDER=msg91
SMS_PROVIDER=mock
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=

# --- WhatsApp Provider ---
WHATSAPP_PROVIDER=mock
# WHATSAPP_API_URL=
# WHATSAPP_API_KEY=

# --- Rate Limiting ---
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# --- Bcrypt ---
BCRYPT_ROUNDS=12
