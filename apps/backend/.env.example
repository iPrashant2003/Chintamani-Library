# ─────────────────────────────────────────────
# CHINTAMANI LIBRARY — CLOUD ENVIRONMENT VARS
# Copy this to .env for local dev
# Set ALL of these in Railway dashboard for production
# ─────────────────────────────────────────────

# ── DATABASE (Neon PostgreSQL — cloud-hosted) ──
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/chintamani_library?sslmode=require"

# ── AUTHENTICATION ──
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your_super_secret_refresh_key_change_this_in_production
REFRESH_TOKEN_EXPIRES_IN=7d

# ── APP SETTINGS ──
PORT=3000
NODE_ENV=production
APP_ENV=production
CORS_ORIGIN=*

# ── CLOUD FILE STORAGE (Cloudinary) ──
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── PRODUCTION URL (used in QR generation) ──
# Deployed on Render.com
BASE_URL=https://chintamani-backend.onrender.com

# ── RATE LIMITING ──
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ── MESSAGING (optional) ──
SMS_PROVIDER=mock
WHATSAPP_PROVIDER=mock

# ── BCRYPT ──
BCRYPT_ROUNDS=12
