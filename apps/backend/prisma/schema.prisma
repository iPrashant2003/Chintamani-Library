// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  OWNER
  ADMIN
  BRANCH_MANAGER
  STAFF
}

enum SeatStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
  BLOCKED
}

enum AttendanceMethod {
  MANUAL
  QR
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK
  OTHER
}

enum ExpenseCategory {
  ELECTRICITY
  INTERNET
  MAINTENANCE
  SALARY
  CLEANING
  EQUIPMENT
  OTHER
}

enum EnquiryStatus {
  NEW
  CONTACTED
  INTERESTED
  CONVERTED
  NOT_INTERESTED
}

enum CommunicationChannel {
  SMS
  WHATSAPP
  PUSH
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum PaymentVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique // e.g. CML, CRH
  slug      String   @unique // e.g. chintamani, city-reading-hub
  logo      String?
  phone     String?
  email     String?
  address   String?
  city      String?
  state     String?
  country   String   @default("India")
  plan      String   @default("STANDARD") // TRIAL, STANDARD, ENTERPRISE
  status    String   @default("ACTIVE") // ACTIVE, SUSPENDED
  settings  String?  // JSON string
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches             Branch[]
  users                User[]
  members              Member[]
  membershipPlans      MembershipPlan[]
  subscriptions        Subscription[]
  seats                Seat[]
  lockers              Locker[]
  attendances          Attendance[]
  payments             Payment[]
  expenses             Expense[]
  enquiries            Enquiry[]
  auditLogs            AuditLog[]
  settingsRel          Settings[]
  notifications        Notification[]
  communicationLogs    CommunicationLog[]
  qrCodes              QrCode[]
  memberRegistrations  MemberRegistration[]
  complaints           Complaint[]
  paymentVerifications PaymentVerification[]
}

model Branch {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  address   String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users                UserBranchAccess[]
  members              Member[]
  seats                Seat[]
  lockers              Locker[]
  attendances          Attendance[]
  expenses             Expense[]
  enquiries            Enquiry[]
  auditLogs            AuditLog[]
  settings             Settings[]
  MembershipPlan       MembershipPlan[]
  memberRegistrations  MemberRegistration[]
  complaints           Complaint[]

  @@index([tenantId])
}

model User {
  id        String   @id @default(uuid())
  tenantId  String?
  name      String
  email     String   @unique
  password  String
  role      Role     @default(STAFF)
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant           Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branches         UserBranchAccess[]
  permissions      Permission[]
  auditLogs        AuditLog[]

  @@index([tenantId])
}

model UserBranchAccess {
  id        String   @id @default(uuid())
  userId    String
  branchId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
}

model Permission {
  id        String   @id @default(uuid())
  userId    String
  action    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, action])
}

model Member {
  id             String   @id @default(uuid())
  tenantId       String
  branchId       String
  memberCode     String
  name           String
  email          String?
  phone          String
  dob            DateTime?
  address        String?
  academicInfo   String?
  isActive       Boolean  @default(true)
  registrationId String?  // link to MemberRegistration that created this member
  portalAccess   Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch               Branch               @relation(fields: [branchId], references: [id])
  subscriptions        Subscription[]
  attendances          Attendance[]
  payments             Payment[]
  complaints           Complaint[]
  paymentVerifications PaymentVerification[]
  registration         MemberRegistration?  @relation(fields: [registrationId], references: [id])

  @@unique([tenantId, memberCode])
  @@index([tenantId])
  @@index([phone])
  @@index([memberCode])
  @@index([branchId])
}

model MembershipPlan {
  id             String   @id @default(uuid())
  tenantId       String
  branchId       String
  name           String
  durationDays   Int
  price          Float
  includesSeat   Boolean  @default(true)
  includesLocker Boolean  @default(false)
  seatAllocation String   @default("ADMIN") // AUTO (24hr) or ADMIN (6hr/12hr)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch              Branch               @relation(fields: [branchId], references: [id])
  subscriptions       Subscription[]
  memberRegistrations MemberRegistration[]

  @@index([tenantId])
}

model Subscription {
  id               String   @id @default(uuid())
  tenantId         String
  memberId         String
  planId           String
  startDate        DateTime
  endDate          DateTime
  status           String   @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED
  assignedSeatId   String?
  assignedLockerId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member           Member         @relation(fields: [memberId], references: [id])
  plan             MembershipPlan @relation(fields: [planId], references: [id])
  seat             Seat?          @relation(fields: [assignedSeatId], references: [id])
  locker           Locker?        @relation(fields: [assignedLockerId], references: [id])
  SeatAssignment   SeatAssignment[]
  LockerAssignment LockerAssignment[]

  @@index([tenantId])
  @@index([endDate])
  @@index([status])
}

model Seat {
  id          String     @id @default(uuid())
  tenantId    String
  branchId    String
  seatNumber  String
  floor       String
  status      SeatStatus @default(AVAILABLE)
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch              Branch               @relation(fields: [branchId], references: [id])
  subscriptions       Subscription[]
  assignments         SeatAssignment[]
  memberRegistrations MemberRegistration[] @relation("ReservedSeat")

  @@unique([branchId, seatNumber])
  @@index([tenantId])
  @@index([seatNumber])
  @@index([status])
}

model SeatAssignment {
  id             String   @id @default(uuid())
  seatId         String
  subscriptionId String
  assignedAt     DateTime @default(now())
  releasedAt     DateTime?

  seat           Seat         @relation(fields: [seatId], references: [id])
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
}

model Locker {
  id           String     @id @default(uuid())
  tenantId     String
  branchId     String
  lockerNumber String
  status       SeatStatus @default(AVAILABLE) // Reusing enum for simplicity
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch         @relation(fields: [branchId], references: [id])
  subscriptions Subscription[]
  assignments  LockerAssignment[]

  @@unique([branchId, lockerNumber])
  @@index([tenantId])
}

model LockerAssignment {
  id             String   @id @default(uuid())
  lockerId       String
  subscriptionId String
  assignedAt     DateTime @default(now())
  releasedAt     DateTime?

  locker         Locker       @relation(fields: [lockerId], references: [id])
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
}

model Attendance {
  id          String           @id @default(uuid())
  tenantId    String
  memberId    String
  branchId    String
  checkIn     DateTime         @default(now())
  checkOut    DateTime?
  method      AttendanceMethod @default(MANUAL)

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member      Member   @relation(fields: [memberId], references: [id])
  branch      Branch   @relation(fields: [branchId], references: [id])

  @@index([tenantId])
  @@index([checkIn])
}

model Payment {
  id          String        @id @default(uuid())
  tenantId    String
  memberId    String
  amount      Float
  method      PaymentMethod
  status      String        @default("PENDING") // PENDING, PAID, FAILED, REJECTED
  paymentType String?       // MEMBERSHIP, MAINTENANCE, RENEWAL, OTHER
  txnRef      String?
  notes       String?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member       Member               @relation(fields: [memberId], references: [id])
  transactions PaymentTransaction[]
  verification PaymentVerification?

  @@index([tenantId])
  @@index([paidAt])
  @@index([status])
}

model PaymentTransaction {
  id          String   @id @default(uuid())
  paymentId   String
  amount      Float
  status      String
  providerRef String?
  createdAt   DateTime @default(now())

  payment     Payment  @relation(fields: [paymentId], references: [id])
}

model Expense {
  id          String          @id @default(uuid())
  tenantId    String
  branchId    String
  category    ExpenseCategory
  amount      Float
  description String?
  date        DateTime        @default(now())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch   @relation(fields: [branchId], references: [id])

  @@index([tenantId])
}

model Enquiry {
  id            String        @id @default(uuid())
  tenantId      String
  branchId      String
  name          String
  phone         String
  email         String?
  status        EnquiryStatus @default(NEW)
  followUpDate  DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch   @relation(fields: [branchId], references: [id])

  @@index([tenantId])
}

model Notification {
  id        String   @id @default(uuid())
  tenantId  String?
  userId    String?
  memberId  String?
  type      String
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model CommunicationLog {
  id        String               @id @default(uuid())
  tenantId  String?
  channel   CommunicationChannel
  recipient String
  message   String
  status    String               @default("SENT")
  createdAt DateTime             @default(now())

  tenant    Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model QrCode {
  id         String   @id @default(uuid())
  tenantId   String?
  entityType String   // MEMBER, LIBRARY_PORTAL, etc.
  entityId   String
  token      String   @unique
  url        String?  // full encoded URL
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([entityType, entityId])
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String?
  userId    String?
  branchId  String?
  action    String
  entity    String
  entityId  String
  metadata  String?  // JSON string
  createdAt DateTime @default(now())

  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])
  branch    Branch?  @relation(fields: [branchId], references: [id])

  @@index([tenantId])
}

model Settings {
  id        String   @id @default(uuid())
  tenantId  String?
  branchId  String?
  key       String
  value     String   // JSON string
  updatedAt DateTime @updatedAt

  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch?  @relation(fields: [branchId], references: [id])

  @@unique([branchId, key])
  @@index([tenantId])
}

// ── NEW MODELS ────────────────────────────────────────────────────────────────

model MemberRegistration {
  id               String             @id @default(uuid())
  tenantId         String
  branchId         String
  applicationId    String             @unique // e.g. REG-000123
  name             String
  phone            String
  email            String?
  dob              DateTime?
  gender           String?
  address          String?
  aadhaarNumber    String?            // masked before display
  emergencyContact String?
  academicInfo     String?            // JSON: batch, course, institute, occupation
  planId           String?
  photoUrl         String?
  aadhaarFrontUrl  String?
  aadhaarBackUrl   String?
  otherDocUrls     String?            // JSON array
  status           RegistrationStatus @default(PENDING)
  rejectionReason  String?
  reservedSeatId   String?            // auto-reserved for AUTO-allocation plans
  memberId         String?            // set after approval
  reviewedBy       String?
  reviewedAt       DateTime?
  submittedAt      DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch          @relation(fields: [branchId], references: [id])
  plan         MembershipPlan? @relation(fields: [planId], references: [id])
  reservedSeat Seat?           @relation("ReservedSeat", fields: [reservedSeatId], references: [id])
  members      Member[]

  @@index([tenantId])
  @@index([phone])
  @@index([status])
}

model Complaint {
  id             String          @id @default(uuid())
  tenantId       String
  branchId       String
  complaintId    String          @unique // e.g. CMP-0012
  memberId       String?
  memberName     String
  memberPhone    String
  category       String          // AC, ELECTRICITY, SEAT, CLEANLINESS, INTERNET, OTHER
  description    String
  attachmentUrls String?         // JSON array of URLs
  status         ComplaintStatus @default(OPEN)
  resolution     String?
  assignedTo     String?
  resolvedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch  Branch   @relation(fields: [branchId], references: [id])
  member  Member?  @relation(fields: [memberId], references: [id])

  @@index([tenantId])
  @@index([status])
}

model PaymentVerification {
  id              String                    @id @default(uuid())
  tenantId        String
  paymentId       String                    @unique
  memberId        String
  amount          Float
  paymentType     String                    // MEMBERSHIP, MAINTENANCE, RENEWAL, OTHER
  screenshotUrl   String?
  txnRef          String?
  upiId           String?
  status          PaymentVerificationStatus @default(PENDING)
  rejectionReason String?
  verifiedBy      String?
  verifiedAt      DateTime?
  submittedAt     DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment Payment  @relation(fields: [paymentId], references: [id])
  member  Member   @relation(fields: [memberId], references: [id])

  @@index([tenantId])
  @@index([status])
}

model MemberPortalSession {
  id        String   @id @default(uuid())
  phone     String
  otp       String
  verified  Boolean  @default(false)
  memberId  String?
  token     String?  @unique // session token after OTP verified
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([token])
}
